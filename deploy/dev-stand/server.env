# Нативный запуск control plane: cd server && set -a && . ../deploy/dev-stand/server.env && set +a && go run ./cmd/main.go
# Postgres и registry — в docker-desktop kubernetes (deploy/dev-stand/infra-k8s.yaml)
PG_DSN=postgres://postgres:postgres@127.0.0.1:30432/loom?sslmode=disable

# таски запускаются docker-контейнерами на хосте: сам control plane нативный,
# в кластер ему ходить незачем
EXECUTOR=docker

GRPC_PORT=5052
HTTP_PORT=8082
SYSTEM_HTTP_PORT=3003
# статику админки в деве раздаёт `pnpm dev` на 3000 — свой ADMIN_DIR не нужен
ADMIN_DIR=/nonexistent
# админка ходит с другого origin (3000 → 8082)
HTTP_CORS=true

SECRET_KEY=dev-secret

ARTIFACT_ADDR=127.0.0.1:5051
# контейнеры тасков видят хост как host.docker.internal
TASK_ARTIFACT_ADDR=host.docker.internal:5051
TASK_SERVER_ADDR=host.docker.internal:5052
