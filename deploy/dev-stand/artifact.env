# Нативный запуск artifact-сервера: cd artifact && set -a && . ../deploy/dev-stand/artifact.env && set +a && go run ./cmd/main.go
GRPC_PORT=5051
SYSTEM_HTTP_PORT=3004
# каталоги стрим-хранилища; путь относительный — от каталога запуска (artifact/)
DATA_DIR=.dev-stand/artifacts
LOG_DIR=.dev-stand/logs
