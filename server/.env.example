# DEBUG=false
# LOG_LEVEL=info

# GRPC_PORT=5052
# HTTP_PORT=8082
# HTTP_CORS=false
# SYSTEM_HTTP_PORT=3004

PG_DSN=postgres://postgres:postgres@127.0.0.1:5432/loom?sslmode=disable

# адрес artifact-сервера для самого control plane (финализация и чтение
# логов, FinishAttempt, retention)
# ARTIFACT_ADDR=127.0.0.1:5051
# адреса artifact/control plane, какими их видят поды тасков (cluster DNS)
# TASK_ARTIFACT_ADDR=loom-artifact:5051
# TASK_SERVER_ADDR=loom-server:5052

# container-CLI для регистрации дагов (pull/describe)
# DOCKER_BIN=docker

# k8s — kubernetes Job'ы; none — без executor'а (dev: только API)
# EXECUTOR=k8s
# K8S_NAMESPACE=default
# пусто — in-cluster; иначе путь к kubeconfig
# K8S_KUBECONFIG=
# K8S_JOB_TTL=1h
# семплинг памяти подов попыток через metrics.k8s.io (нужен metrics-server);
# 0 — выключено
# K8S_METRICS_TICK=15s

# SCHED_TICK=2s
# SCHED_CLAIM_LIMIT=10

# очередь асинхронных регистраций дагов
# DAG_REG_TICK=2s
# DAG_REG_STALE=30m
# DAG_REG_TTL=720h

# парольная фраза шифрования секретов (пусто — plaintext, только dev)
# SECRET_KEY=
